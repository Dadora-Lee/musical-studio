# ═══════════════════════════════════════════════════════════════
# Musical Studio · .gitignore
# 시크릿/빌드 산출물 보호. public repo이므로 특히 엄격하게.
# ═══════════════════════════════════════════════════════════════

# ─── Secrets (절대 커밋 금지) ────────────────────────────────────
.env/
.env
.env.*
!.env.example
*credential*.json
*client_secret*.json
service-account*.json
*.pem
*.key
secrets/

# ─── Node / Next.js ──────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing ─────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ─── OS ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editors ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Claude / AI 로컬 ────────────────────────────────────────────
.claude/settings.local.json
.claude/*.local.*
.agents/*.local.*

# ─── Supabase 로컬 ───────────────────────────────────────────────
supabase/.branches/
supabase/.temp/

# ─── 임시/캐시 ───────────────────────────────────────────────────
*.tmp
*.bak
.cache/

# ─── 음원·악보 샘플은 LFS나 외부 저장 권장 (저작권 보호) ────────
public/audio/private/
public/scores/private/
