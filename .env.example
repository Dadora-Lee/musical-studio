# Musical Studio · 환경변수 예시
# 실제 값은 .env/secrets.env 또는 .env.local 에 (.gitignore 보호)
#
# ⚠️ 이 파일은 placeholder만. 절대 실제 값 넣지 말 것. 커밋됨!

# ─── GitHub ────────────────────────────────────────
GITHUB_TOKEN=<your-github-pat>
GITHUB_REPO_OWNER=<your-github-username>
GITHUB_REPO_NAME=musical-studio

# ─── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=<https://xxxxx.supabase.co>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<jwt-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<jwt-service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret-base64>
SUPABASE_DB_PASSWORD=<db-password>
SUPABASE_PROJECT_REF=<xxxxx>
DATABASE_URL=postgresql://postgres:<URL_ENCODED_PWD>@db.<REF>.supabase.co:5432/postgres

# ─── Google OAuth + Drive ──────────────────────────
GOOGLE_CLIENT_ID=<xxx.apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<GOCSPX-xxx>
GOOGLE_OAUTH_JSON_PATH=.env/client_secret.json

# ─── Next.js App ───────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=<auto-generated, openssl rand -base64 32>
DEV_ACCESS_TOKEN=<auto-generated, sharable token for dev access>

# ─── 외부 노출 (LAN/WAN) ───────────────────────────
HOST_LAN_IP=192.168.x.x
HOST_PUBLIC_IP=xxx.xxx.xxx.xxx
DEV_PORT=3000
SUPABASE_API_PORT=54321
DDNS_HOSTNAME=<your-subdomain>.<ddns-domain>
DDNS_PROVIDER=<freedynamicdns|noip|duckdns|...>
